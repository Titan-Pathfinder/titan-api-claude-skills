# Lockfile must be present and up-to-date; fail if it would change
package-lock=true

# Prevent install scripts from running (common supply chain attack vector)
ignore-scripts=true

# Require exact versions when adding new deps (no ^ or ~ prefix)
save-exact=true

# Enforce strict peer dependency resolution
strict-peer-deps=true

# Disable anonymous npm telemetry
fund=false
audit-level=moderate
